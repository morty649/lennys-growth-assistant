APP_ENV=production
DEPLOYMENT_MODE=cloud
WEB_ORIGIN=https://your-frontend.example

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
VECTOR_BACKEND=pgvector
EMBEDDING_BACKEND=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EMBED_FUNCTION=embed
AUTO_INGEST=true
CORPUS_ROOT=/app/corpus

AUTH_MODE=anonymous
ANONYMOUS_TOKEN_SECRET=replace-with-at-least-32-random-characters
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=3600

DEFAULT_PROVIDER=groq
ENABLE_GROQ=true
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

AGENT_URL=http://127.0.0.1:8787
API_INTERNAL_URL=http://127.0.0.1:8000
INTERNAL_TOOL_TOKEN=replace-with-a-random-internal-token
REQUEST_TIMEOUT_SECONDS=180
