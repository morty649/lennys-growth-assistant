# Local application
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
INTERNAL_TOOL_TOKEN=local-dev-tool-token-change-me

# PostgreSQL and Chroma
POSTGRES_DB=lenny_growth
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_local_password
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://lenny:lenny_local_password@postgres:5432/lenny_growth
CHROMA_HOST=chroma
CHROMA_PORT=8000
AUTO_INGEST=true
CORPUS_ROOT=/corpus
EMBEDDING_BACKEND=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# Agent provider defaults
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:8b
LOCAL_MODEL_THINKING=off
REQUEST_TIMEOUT_SECONDS=600
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_API_KEY=
ENABLE_GROQ=false
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=

# Internal services
AGENT_HOST=0.0.0.0
AGENT_URL=http://agent:8787
API_INTERNAL_URL=http://api:8000
